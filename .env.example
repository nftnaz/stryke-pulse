# App
APP_NAME=Stryke Pulse
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Upstox (Analysis / Market Information APIs)
# Get access token from Upstox developer console / login flow
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
# Base URL is usually https://api.upstox.com/v2

# LLM / RAG
LLM_PROVIDER=groq          # groq | ollama
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# Data
DEFAULT_INDEX=NIFTY
DEFAULT_EXPIRY=             # leave blank for nearest
TIMEZONE=Asia/Kolkata
